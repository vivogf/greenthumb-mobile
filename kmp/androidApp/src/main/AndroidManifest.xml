<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть (Stage 2): без этого разрешения все HTTP-вызовы падают с
         Network/UnknownHost ещё на connect — me/recovery/login не доходят
         до сервера. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Состояние сети (Stage 4 п.8, Connectivity): без него
         registerDefaultNetworkCallback бросает SecurityException, и полоса
         «нет сети» с третьим триггером обновления работать не будут. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".GreenThumbApplication"
        android:label="GreenThumb"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- configChanges uiMode (Stage 6 п.3): смена системной темы НЕ
             пересоздаёт Activity (как у Expo-активности RN), и Compose
             обновляет LocalConfiguration на месте — автотема перечитывается
             без рестарта. Это поведение-паритет, НЕ обход корректности:
             пересоздание Activity при повороте/масштабе шрифта безопасно —
             SessionGraph и opener баз живут на процесс в GreenThumbApplication
             (фикс M6 VAL-SHELL-003), Connectivity — ресурс Activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть (Stage 2): без этого разрешения все HTTP-вызовы падают с
         Network/UnknownHost ещё на connect — me/recovery/login не доходят
         до сервера. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Состояние сети (Stage 4 п.8, Connectivity): без него
         registerDefaultNetworkCallback бросает SecurityException, и полоса
         «нет сети» с третьим триггером обновления работать не будут. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="GreenThumb"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- configChanges uiMode (Stage 6 п.3): смена системной темы НЕ
             пересоздаёт Activity (как у Expo-активности RN). Дефолтное
             пересоздание строило бы второй SessionGraph в том же процессе
             поверх живых DataStore-инстансов (один активный DataStore на
             файл на процесс — IllegalStateException на первом чтении).
             Реактивность даёт Compose: onConfigurationChanged обновляет
             MutableState-configuration, и LocalConfiguration (а с ней
             GreenThumbTheme в auto) перечитывается без рестарта. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

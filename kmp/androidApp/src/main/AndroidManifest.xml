<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Сеть (Stage 2): без этого разрешения все HTTP-вызовы падают с
         Network/UnknownHost ещё на connect — me/recovery/login не доходят
         до сервера. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Состояние сети (Stage 4 п.8, Connectivity): без него
         registerDefaultNetworkCallback бросает SecurityException, и полоса
         «нет сети» с третьим триггером обновления работать не будут. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Пикер фото (Stage 8 п.1): камера (TakePicture) и медиатека —
         RN-паритет requestCameraPermissionsAsync/requestMediaLibraryPermissionsAsync
         (запрос ДО пикера, отказ → локализованный алерт). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Пуш-уведомления (M9 push-android): runtime-разрешение API 33+
         (RN-паритет requestPermissionsAsync; ниже 33 выдано неявно). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GreenThumbApplication"
        android:label="GreenThumb"
        android:supportsRtl="true"
        android:fullBackupContent="@xml/full_backup_content"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- Канал фоновых FCM-доставок (M9): когда приложение в фоне/убито,
             система показывает notification-полезную нагрузку сама — через
             наш канал `default` (HIGH, вибрация, цвет), а не «Miscellaneous». -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="default" />

        <!-- configChanges uiMode (Stage 6 п.3): смена системной темы НЕ
             пересоздаёт Activity (как у Expo-активности RN), и Compose
             обновляет LocalConfiguration на месте — автотема перечитывается
             без рестарта. Это поведение-паритет, НЕ обход корректности:
             пересоздание Activity при повороте/масштабе шрифта безопасно —
             SessionGraph и opener баз живут на процесс в GreenThumbApplication
             (фикс M6 VAL-SHELL-003), Connectivity — ресурс Activity.
             launchMode singleTask — паритет RN-активности (android/app): тап
             по пушу при живом процессе доставляет intent в onNewIntent
             (Stage 9 п.7, deep-link plant_id), а не плодит второй экземпляр
             поверх задачи. VIEW/deep-link фильтров НЕТ (схема greenthumb://
             зарегистрирована только у RN-сборки; KMP маршрутизирует extras
             launch-intent'а FCM, без VIEW-маршрутов). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Перехват FCM (M9 push-android, Stage 9 п.5): форграунд-пуш
             SDK сам не показывает — сервис показывает через канал `default`
             (баннер + список + звук). -->
        <service
            android:name=".GtFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- content:// для EXTRA_OUTPUT камеры (Stage 8 п.1): кадр пишется в
             cacheDir/gt-pick-*.jpg и читается приложением же; пути —
             res/xml/file_paths.xml (cache-path gt-pick). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ light window (M10 VAL-LOOK-004). The system picks this or values-night-v31 from
         the app night mode, which SyncAppNightMode sets from the in-app Light/Dark/Auto choice, so the
         cold-start splash already has the chosen «Лес» page colour. Older Android keeps the dark
         window of values/themes.xml. -->
    <style name="Theme.GreenThumb" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/gt_page_light</item>
        <item name="android:colorBackground">@color/gt_page_light</item>
        <item name="android:statusBarColor">@color/gt_page_light</item>
        <item name="android:navigationBarColor">@color/gt_page_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/gt_page_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/gt_page_light</item>
    </style>
</resources>

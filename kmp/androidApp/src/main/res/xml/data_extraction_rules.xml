<?xml version="1.0" encoding="utf-8"?>
<!-- Data Extraction Rules (API 31+): SecureStore-шифротекст исключён и из
     облачного бэкапа, и из device-to-device переноса (ключ AES-GCM остаётся
     в AndroidKeyStore исходного устройства). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="greenthumb_secure_store.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="greenthumb_secure_store.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
